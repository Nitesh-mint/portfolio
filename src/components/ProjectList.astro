---
import { Github, Globe, Calendar, Folder, LayoutGrid, List } from "lucide-react";

let projects = [];
let errorMsg = "";

try {
    const response = await fetch("https://raw.githubusercontent.com/Nitesh-mint/portfolio-data/refs/heads/main/data.json");
    if (!response.ok) {
        throw new Error(`Failed to fetch: ${response.statusText}`);
    }
    const rawText = await response.text();
    // Clean up trailing commas from JSON to handle potential user syntax mistakes robustly
    const cleanedText = rawText.replace(/,\s*([\]}])/g, "$1");
    const data = JSON.parse(cleanedText);
    projects = data.projects || [];
} catch (e) {
    console.error("Error fetching projects:", e);
    errorMsg = "Unable to load projects at this time.";
}

// Extract unique technologies and tags for filters
const allTechs = Array.from(new Set(projects.flatMap((p) => p.tech || [])));
const allTags = Array.from(new Set(projects.flatMap((p) => p.tags || [])));
const filterCategories = ["all", ...allTechs, ...allTags];

// Helper for neobrutalist badge color matching based on name/index
const getBadgeStyles = (index: number) => {
    const colorSchemes = [
        "bg-pink-400 text-black dark:bg-pink-600 dark:text-white",
        "bg-cyan-300 text-black dark:bg-cyan-600 dark:text-white",
        "bg-yellow-300 text-black dark:bg-yellow-500 dark:text-black",
        "bg-lime-400 text-black dark:bg-lime-600 dark:text-white",
        "bg-violet-400 text-black dark:bg-violet-600 dark:text-white",
        "bg-orange-400 text-black dark:bg-orange-600 dark:text-white"
    ];
    return colorSchemes[index % colorSchemes.length];
};
---

<section
    id="projects"
    class="px-8 md:px-8 py-8 border-b-[3px] border-border-primary"
>
    <h3
        class="font-display font-black text-3xl md:text-6xl leading-[0.9] uppercase tracking-wider mb-6 text-left"
    >
        Projects.
    </h3>
    
    <p class="font-mono text-sm md:text-lg text-text-muted mb-8 max-w-2xl">
        A catalog of my recent tools, extensions, and applications. 
        Click the tags below to filter dynamically in real-time.
    </p>

    {errorMsg && (
        <div class="card-brutal bg-red-100 text-red-800 border-red-500 dark:bg-red-950/30 dark:text-red-300 dark:border-red-800 font-mono text-sm p-4">
            {errorMsg}
        </div>
    )}

    {!errorMsg && (
        <>
            <!-- Filter & View Switcher Bar -->
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6 mb-10">
                <!-- Dynamic Filters -->
                <div class="flex flex-wrap gap-2.5">
                    <button
                        class="project-filter-btn px-4 py-2 border-[3px] border-border-primary font-mono text-xs font-black uppercase cursor-pointer transition-all duration-100 shadow-[3px_3px_0_var(--border-color)] hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[2px_2px_0_var(--border-color)] active:translate-x-[3px] active:translate-y-[3px] active:shadow-none bg-text-primary text-bg-primary"
                        data-filter="all"
                    >
                        All ({projects.length})
                    </button>
                    {filterCategories.filter(f => f !== "all").map((filterName, idx) => (
                        <button
                            class="project-filter-btn px-4 py-2 border-[3px] border-border-primary font-mono text-xs font-black uppercase cursor-pointer transition-all duration-100 shadow-[3px_3px_0_var(--border-color)] hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[2px_2px_0_var(--border-color)] active:translate-x-[3px] active:translate-y-[3px] active:shadow-none bg-bg-primary text-text-primary"
                            data-filter={filterName}
                        >
                            {filterName}
                        </button>
                    ))}
                </div>

                <!-- View Toggle Buttons -->
                <div class="flex items-center self-start lg:self-center border-[3px] border-border-primary bg-bg-primary shadow-[4px_4px_0_var(--border-color)] select-none shrink-0">
                    <button
                        id="view-grid-btn"
                        class="flex items-center gap-2 px-3 py-2 border-r-[3px] border-border-primary font-mono text-xs font-black uppercase cursor-pointer transition-colors duration-100 bg-text-primary text-bg-primary"
                        aria-label="Grid View"
                    >
                        <LayoutGrid className="w-4 h-4" /> Grid
                    </button>
                    <button
                        id="view-list-btn"
                        class="flex items-center gap-2 px-3 py-2 font-mono text-xs font-black uppercase cursor-pointer transition-colors duration-100 bg-bg-primary text-text-primary hover:bg-text-primary/10"
                        aria-label="List View"
                    >
                        <List className="w-4 h-4" /> List
                    </button>
                </div>
            </div>

            <!-- Project Grid View (Default) -->
            <div
                id="projects-grid"
                class="grid grid-cols-1 md:grid-cols-2 gap-8"
            >
                {projects.map((project, index) => (
                    <div
                        class="project-card card-brutal flex flex-col justify-between h-full group"
                        data-techs={JSON.stringify(project.tech || [])}
                        data-tags={JSON.stringify(project.tags || [])}
                    >
                        <div>
                            <!-- Header Info -->
                            <div class="flex justify-between items-center mb-4">
                                <span class="font-mono text-xs text-text-muted flex items-center gap-1.5">
                                    <Calendar className="w-4 h-4" /> {project.year}
                                </span>
                                <span
                                    class={`font-mono text-[10px] md:text-xs px-2.5 py-1 border-[2px] border-border-primary font-bold uppercase shadow-[2px_2px_0_var(--border-color)] ${
                                        project.status === "completed"
                                            ? "bg-emerald-400 text-black dark:bg-emerald-600 dark:text-white"
                                            : "bg-amber-300 text-black dark:bg-amber-500"
                                    }`}
                                >
                                    {project.status === "in_progress" && (
                                        <span class="inline-block w-2.5 h-2.5 rounded-full bg-red-600 dark:bg-red-400 animate-pulse mr-1.5 align-middle"></span>
                                    )}
                                    <span class="align-middle">{project.status.replace("_", " ")}</span>
                                </span>
                            </div>

                            <!-- Title -->
                            <h4 class="font-display text-xl md:text-3xl font-black uppercase mb-3 leading-tight tracking-tight border-b-[2px] border-border-primary/20 pb-2">
                                {project.title}
                            </h4>

                            <!-- Description -->
                            <p class="font-mono text-sm md:text-base text-text-muted mb-6 leading-relaxed min-h-[60px]">
                                {project.description}
                            </p>
                        </div>

                        <div>
                            <!-- Tags and Tech Badges -->
                            <div class="flex flex-wrap gap-2 mb-6">
                                {(project.tech || []).map((tech) => (
                                    <span class="font-mono text-[10px] md:text-xs px-2.5 py-1 border-[2px] border-border-primary bg-bg-secondary text-text-primary font-medium">
                                        #{tech}
                                    </span>
                                ))}
                                {(project.tags || []).map((tag, tagIdx) => (
                                    <span class={`font-mono text-[10px] md:text-xs px-2.5 py-1 border-[2px] border-border-primary font-black uppercase ${getBadgeStyles(tagIdx + index)}`}>
                                        {tag}
                                    </span>
                                ))}
                            </div>

                            <!-- Links Footer -->
                            <div class="flex gap-4 border-t-[2px] border-border-primary/20 pt-4">
                                {project.links?.github && (
                                    <a
                                        href={project.links.github}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="flex items-center gap-2 px-4 py-2 border-[2px] border-border-primary font-mono text-xs font-bold uppercase transition-all duration-100 shadow-[3px_3px_0_var(--border-color)] hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[2px_2px_0_var(--border-color)] active:translate-x-[3px] active:translate-y-[3px] active:shadow-none bg-bg-primary hover:bg-text-primary hover:text-bg-primary cursor-pointer"
                                    >
                                        <Github className="w-4 h-4" /> Repository
                                    </a>
                                )}
                                {project.links?.live && (
                                    <a
                                        href={project.links.live}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="flex items-center gap-2 px-4 py-2 border-[2px] border-border-primary font-mono text-xs font-bold uppercase transition-all duration-100 shadow-[3px_3px_0_var(--border-color)] hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[2px_2px_0_var(--border-color)] active:translate-x-[3px] active:translate-y-[3px] active:shadow-none bg-bg-primary hover:bg-text-primary hover:text-bg-primary cursor-pointer"
                                    >
                                        <Globe className="w-4 h-4" /> Live Demo
                                    </a>
                                )}
                            </div>
                        </div>
                    </div>
                ))}
            </div>

            <!-- Project Compact List View (Hidden by default) -->
            <div
                id="projects-list"
                class="hidden flex-col border-[3px] border-border-primary divide-y-[3px] divide-border-primary shadow-[8px_8px_0_var(--border-color)] bg-bg-primary"
            >
                {projects.map((project, index) => (
                    <div
                        class="project-list-item flex flex-col md:flex-row md:items-center justify-between p-6 bg-bg-primary hover:bg-bg-secondary transition-all duration-150 group"
                        data-techs={JSON.stringify(project.tech || [])}
                        data-tags={JSON.stringify(project.tags || [])}
                    >
                        <!-- Left: Info & Description -->
                        <div class="flex flex-col gap-1 md:max-w-[45%]">
                            <div class="flex items-center gap-3">
                                <span class="font-mono text-xs font-bold text-text-muted">
                                    {project.year}
                                </span>
                                <span
                                    class={`font-mono text-[9px] px-1.5 py-0.5 border border-border-primary font-bold uppercase shadow-[1.5px_1.5px_0_var(--border-color)] ${
                                        project.status === "completed"
                                            ? "bg-emerald-400 text-black dark:bg-emerald-600 dark:text-white"
                                            : "bg-amber-300 text-black dark:bg-amber-500"
                                    }`}
                                >
                                    {project.status.replace("_", " ")}
                                </span>
                            </div>
                            <h4 class="font-display text-lg md:text-xl font-black uppercase tracking-tight group-hover:translate-x-1 transition-transform">
                                {project.title}
                            </h4>
                            <p class="font-mono text-xs text-text-muted leading-relaxed">
                                {project.description}
                            </p>
                        </div>

                        <!-- Middle: Badges -->
                        <div class="flex flex-wrap gap-1.5 my-4 md:my-0 md:max-w-[35%]">
                            {(project.tech || []).map((tech) => (
                                <span class="font-mono text-[10px] px-2 py-0.5 border border-border-primary bg-bg-secondary text-text-primary">
                                    #{tech}
                                </span>
                            ))}
                            {(project.tags || []).map((tag, tagIdx) => (
                                <span class={`font-mono text-[10px] px-2 py-0.5 border border-border-primary font-black uppercase ${getBadgeStyles(tagIdx + index)}`}>
                                    {tag}
                                </span>
                            ))}
                        </div>

                        <!-- Right: Link Actions -->
                        <div class="flex gap-3 md:max-w-[15%]">
                            {project.links?.github && (
                                <a
                                    href={project.links.github}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="p-2.5 border-[2px] border-border-primary bg-bg-primary text-text-primary hover:bg-text-primary hover:text-bg-primary transition-all duration-100 shadow-[3px_3px_0_var(--border-color)] hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[2px_2px_0_var(--border-color)] active:translate-x-[3px] active:translate-y-[3px] active:shadow-none cursor-pointer"
                                    aria-label="GitHub Repository"
                                >
                                    <Github className="w-4 h-4" />
                                </a>
                            )}
                            {project.links?.live && (
                                <a
                                    href={project.links.live}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="p-2.5 border-[2px] border-border-primary bg-bg-primary text-text-primary hover:bg-text-primary hover:text-bg-primary transition-all duration-100 shadow-[3px_3px_0_var(--border-color)] hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[2px_2px_0_var(--border-color)] active:translate-x-[3px] active:translate-y-[3px] active:shadow-none cursor-pointer"
                                    aria-label="Live Demo"
                                >
                                    <Globe className="w-4 h-4" />
                                </a>
                            )}
                        </div>
                    </div>
                ))}
            </div>
        </>
    )}
</section>

<script>
    const filterButtons = document.querySelectorAll(".project-filter-btn");
    const projectCards = document.querySelectorAll(".project-card");
    const projectListItems = document.querySelectorAll(".project-list-item");
    const gridBtn = document.getElementById("view-grid-btn");
    const listBtn = document.getElementById("view-list-btn");
    const gridContainer = document.getElementById("projects-grid");
    const listContainer = document.getElementById("projects-list");

    let currentFilter = "all";

    function applyFilter() {
        // Filter Grid Cards
        projectCards.forEach((cardEl) => {
            const card = cardEl as HTMLElement;
            if (currentFilter === "all") {
                card.style.display = "flex";
                void card.offsetHeight;
                card.style.opacity = "1";
                card.style.transform = "scale(1)";
            } else {
                const techs = JSON.parse(card.getAttribute("data-techs") || "[]");
                const tags = JSON.parse(card.getAttribute("data-tags") || "[]");

                if (techs.includes(currentFilter) || tags.includes(currentFilter)) {
                    card.style.display = "flex";
                    void card.offsetHeight;
                    card.style.opacity = "1";
                    card.style.transform = "scale(1)";
                } else {
                    card.style.opacity = "0";
                    card.style.transform = "scale(0.95)";
                    setTimeout(() => {
                        if (card.style.opacity === "0") {
                            card.style.display = "none";
                        }
                    }, 150);
                }
            }
        });

        // Filter List Items
        projectListItems.forEach((itemEl) => {
            const item = itemEl as HTMLElement;
            if (currentFilter === "all") {
                item.style.display = "flex";
                void item.offsetHeight;
                item.style.opacity = "1";
            } else {
                const techs = JSON.parse(item.getAttribute("data-techs") || "[]");
                const tags = JSON.parse(item.getAttribute("data-tags") || "[]");

                if (techs.includes(currentFilter) || tags.includes(currentFilter)) {
                    item.style.display = "flex";
                    void item.offsetHeight;
                    item.style.opacity = "1";
                } else {
                    item.style.opacity = "0";
                    setTimeout(() => {
                        if (item.style.opacity === "0") {
                            item.style.display = "none";
                        }
                    }, 150);
                }
            }
        });
    }

    // Filter Listeners
    filterButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
            currentFilter = btn.getAttribute("data-filter") || "all";

            // Reset all buttons to default state
            filterButtons.forEach((b) => {
                b.classList.remove("bg-text-primary", "text-bg-primary");
                b.classList.add("bg-bg-primary", "text-text-primary");
            });

            // Make active button stand out
            btn.classList.remove("bg-bg-primary", "text-text-primary");
            btn.classList.add("bg-text-primary", "text-bg-primary");

            applyFilter();
        });
    });

    // View Listeners
    gridBtn?.addEventListener("click", () => {
        gridBtn.classList.remove("bg-bg-primary", "text-text-primary");
        gridBtn.classList.add("bg-text-primary", "text-bg-primary");
        
        listBtn?.classList.remove("bg-text-primary", "text-bg-primary");
        listBtn?.classList.add("bg-bg-primary", "text-text-primary");

        if (gridContainer) gridContainer.style.display = "grid";
        if (listContainer) listContainer.style.display = "none";
    });

    listBtn?.addEventListener("click", () => {
        listBtn.classList.remove("bg-bg-primary", "text-text-primary");
        listBtn.classList.add("bg-text-primary", "text-bg-primary");

        gridBtn?.classList.remove("bg-text-primary", "text-bg-primary");
        gridBtn?.classList.add("bg-bg-primary", "text-text-primary");

        if (gridContainer) gridContainer.style.display = "none";
        if (listContainer) {
            listContainer.style.display = "flex";
            listContainer.style.flexDirection = "column";
        }
    });
</script>

<style>
    .project-card, .project-list-item {
        transition: opacity 150ms ease, transform 150ms ease, border-color 100ms ease, box-shadow 100ms ease, background-color 100ms ease;
    }
</style>
