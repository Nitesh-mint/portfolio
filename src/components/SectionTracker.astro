---
import { Settings } from "lucide-react";
---

<div
    id="section-tracker"
    class="hidden xl:flex fixed left-6 top-1/2 -translate-y-1/2 flex-col items-center gap-4 z-40 transition-opacity duration-500 opacity-0"
>
    <!-- Scroll Wheel -->
    <div class="relative w-12 h-12 mb-4">
        <Settings
            id="scroll-wheel"
            className="w-full h-full text-text-primary transition-transform duration-75 will-change-transform"
        />
    </div>

    <!-- Track Line -->
    <div class="w-[3px] h-32 bg-border-primary opacity-30"></div>

    <!-- Steps -->
    <div
        class="flex flex-col gap-6 font-mono text-xs font-bold text-text-muted"
    >
        <a
            href="#home"
            class="tracker-step group flex items-center gap-2 transition-all duration-300"
            data-target="home"
        >
            <span
                class="w-3 h-3 border-[2px] border-text-primary bg-bg-primary group-hover:bg-text-primary transition-colors duration-300"
            ></span>
            <span
                class="opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 absolute left-8 bg-text-primary text-bg-primary px-1 whitespace-nowrap"
            >
                01 HOME
            </span>
        </a>

        <a
            href="#about"
            class="tracker-step group flex items-center gap-2 transition-all duration-300"
            data-target="about"
        >
            <span
                class="w-3 h-3 border-[2px] border-text-primary bg-bg-primary group-hover:bg-text-primary transition-colors duration-300"
            ></span>
            <span
                class="opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 absolute left-8 bg-text-primary text-bg-primary px-1 whitespace-nowrap"
            >
                02 ABOUT
            </span>
        </a>

        <a
            href="#skills"
            class="tracker-step group flex items-center gap-2 transition-all duration-300"
            data-target="skills"
        >
            <span
                class="w-3 h-3 border-[2px] border-text-primary bg-bg-primary group-hover:bg-text-primary transition-colors duration-300"
            ></span>
            <span
                class="opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 absolute left-8 bg-text-primary text-bg-primary px-1 whitespace-nowrap"
            >
                03 SKILLS
            </span>
        </a>

        <a
            href="#work"
            class="tracker-step group flex items-center gap-2 transition-all duration-300"
            data-target="work"
        >
            <span
                class="w-3 h-3 border-[2px] border-text-primary bg-bg-primary group-hover:bg-text-primary transition-colors duration-300"
            ></span>
            <span
                class="opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 absolute left-8 bg-text-primary text-bg-primary px-1 whitespace-nowrap"
            >
                04 WORK
            </span>
        </a>

        <a
            href="#uses"
            class="tracker-step group flex items-center gap-2 transition-all duration-300"
            data-target="uses"
        >
            <span
                class="w-3 h-3 border-[2px] border-text-primary bg-bg-primary group-hover:bg-text-primary transition-colors duration-300"
            ></span>
            <span
                class="opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 absolute left-8 bg-text-primary text-bg-primary px-1 whitespace-nowrap"
            >
                05 USES
            </span>
        </a>
    </div>

    <!-- Track Line Bottom -->
    <div class="w-[3px] h-32 bg-border-primary opacity-30"></div>
</div>

<style>
    .tracker-active span:first-child {
        background-color: var(--text-color);
        transform: scale(1.3);
    }
</style>

<script>
    const tracker = document.getElementById("section-tracker");
    const wheel = document.getElementById("scroll-wheel");
    const steps = document.querySelectorAll(".tracker-step");

    if (tracker && wheel) {
        // Show tracker after mount
        setTimeout(() => {
            tracker.classList.remove("opacity-0");
        }, 500);

        // 1. Wheel Rotation Logic
        window.addEventListener("scroll", () => {
            const scrollPercent =
                window.scrollY /
                (document.body.scrollHeight - window.innerHeight);
            const rotation = scrollPercent * 360 * 2; // Spin twice fully
            wheel.style.transform = `rotate(${rotation}deg)`;
        });

        // 2. Section Intersection Logic
        const observerOptions = {
            root: null,
            rootMargin: "-20% 0px -20% 0px", // Active when in middle 60% of screen
            threshold: 0.2,
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    // Remove active class from all
                    steps.forEach((step) =>
                        step.classList.remove("tracker-active"),
                    );

                    // Add active class to corresponding step
                    const id = entry.target.id;
                    const activeStep = document.querySelector(
                        `.tracker-step[data-target="${id}"]`,
                    );
                    if (activeStep) {
                        activeStep.classList.add("tracker-active");
                    }
                }
            });
        }, observerOptions);

        // 3. Smooth Scroll Logic
        steps.forEach((step) => {
            step.addEventListener("click", (e) => {
                e.preventDefault();
                const targetId = step.getAttribute("data-target");
                const targetElement = document.getElementById(targetId);

                if (targetElement) {
                    const navbarHeight = 96; // Adjust based on your pt-24 (24 * 4px = 96px)
                    const elementPosition = targetElement.getBoundingClientRect().top;
                    const offsetPosition = elementPosition + window.scrollY - navbarHeight;

                    window.scrollTo({
                        top: offsetPosition,
                        behavior: "smooth",
                    });

                    // Update URL hash without jumping
                    history.pushState(null, null, `#${targetId}`);
                }
            });
        });

        // Observe sections
        ["home", "about", "skills", "work", "uses"].forEach((id) => {            const el = document.getElementById(id);
            if (el) observer.observe(el);
        });
    }
</script>
