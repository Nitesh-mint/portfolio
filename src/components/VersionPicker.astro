---
import { ChevronDown } from "lucide-react";

const versions = [
    { label: "V1.0 (UBUNTU)", url: "https://ubuntu.niteshraya.com.np" },
    { label: "V2.0 (CURRENT)", url: "#", active: true },
    {label: "BLOG", url: "https://blogs.niteshraya.com.np"},
    {label: "Old", url: "https://old.niteshraya.com.np"}
];
---

<div class="relative group h-12 flex items-center" id="version-picker">
    <button
        class="flex items-center h-full gap-2 px-4 bg-primary text-primary border-[3px] border-border-primary font-mono font-black text-xs uppercase shadow-[4px_4px_0_var(--border-color)] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[2px_2px_0_var(--border-color)] transition-all cursor-pointer group-hover:bg-bg-primary group-hover:text-text-primary"
    >
        V2.0 <ChevronDown className="w-4 h-4 ml-1" />
    </button>
    
    <div class="absolute top-full right-0 mt-0 w-48 bg-bg-primary border-[3px] border-border-primary shadow-[8px_8px_0_var(--border-color)] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50 pointer-events-auto">
        <div class="p-2 border-b-[3px] border-border-primary bg-text-primary text-bg-primary font-display text-[10px] uppercase tracking-widest text-center">
            Switch Version
        </div>
        <div class="flex flex-col">
            {versions.map(v => (
                <a 
                    href={v.url} 
                    class={`block p-3 font-mono text-xs font-bold border-b-[3px] border-border-primary last:border-b-0 transition-colors
                        ${v.active 
                            ? 'bg-bg-secondary text-text-primary cursor-default opacity-80' 
                            : 'text-text-primary hover:bg-text-primary hover:text-bg-primary'
                        }`}
                >
                    {v.label} {v.active && '(ACTIVE)'}
                </a>
            ))}
        </div>
    </div>
</div>
