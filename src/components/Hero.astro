</section>

<script define:vars={{ scatterImages: imageSources }}>
    const chaosContainer = document.getElementById("chaos-container");
    const mainImageBtn = document.getElementById("hero-image-btn");
    const container = document.getElementById("scatter-images");
    let isScattered = false;
    let isDragging = false; // Flag to distinguish click vs drag

    if (chaosContainer && mainImageBtn && container) {
        // Select random 4 images from the available pool
        const selectedImages = scatterImages
            .sort(() => Math.random() - 0.5)
            .slice(0, 4);

        // Pre-render images
        selectedImages.forEach((src, i) => {
            const img = document.createElement("img");
            img.src = src;
            img.draggable = false; // Disable native drag
            img.className =
                "absolute top-0 left-0 w-full h-full object-cover border-[3px] border-text-primary shadow-[8px_8px_0_var(--text-color)] transition-all duration-700 ease-[cubic-bezier(0.33,1,0.68,1)] opacity-0 scale-50 pointer-events-auto cursor-grab active:cursor-grabbing";
            img.style.transformOrigin = "center center";

            // Interaction Handlers
            let startX, startY, initialImgX, initialImgY;

            img.addEventListener("mousedown", (e) => {
                if (!isScattered) return;

                // Prevent text selection
                e.preventDefault();

                isDragging = false;
                startX = e.clientX;
                startY = e.clientY;
                initialImgX = parseFloat(img.dataset.x) || 0;
                initialImgY = parseFloat(img.dataset.y) || 0;

                // Disable transition during drag for responsiveness
                img.style.transition = "none";
                img.style.zIndex = "100"; // Bring to front

                const onMouseMove = (moveEvent) => {
                    const dx = moveEvent.clientX - startX;
                    const dy = moveEvent.clientY - startY;

                    if (Math.abs(dx) > 5 || Math.abs(dy) > 5) {
                        isDragging = true;
                    }

                    const newX = initialImgX + dx;
                    const newY = initialImgY + dy;

                    img.dataset.x = newX;
                    img.dataset.y = newY;

                    // Apply transform efficiently
                    img.style.transform = `translate(${newX}px, ${newY}px) rotate(${img.dataset.r}deg) scale(1.5)`;
                };

                const onMouseUp = () => {
                    // Re-enable transitions
                    img.style.transition =
                        "all 0.7s cubic-bezier(0.33, 1, 0.68, 1)";
                    img.style.zIndex = "50";

                    document.removeEventListener("mousemove", onMouseMove);
                    document.removeEventListener("mouseup", onMouseUp);
                };

                document.addEventListener("mousemove", onMouseMove);
                document.addEventListener("mouseup", onMouseUp);
            });

            container.appendChild(img);
        });

        const imgs = container.querySelectorAll("img");

        // Handle Toggle Logic
        chaosContainer.addEventListener("click", (e) => {
            // If we just finished a drag, do NOT toggle
            if (isDragging) {
                isDragging = false;
                return;
            }

            isScattered = !isScattered;

            if (isScattered) {
                // Hide main image
                mainImageBtn.style.opacity = "0";
                mainImageBtn.style.pointerEvents = "none";

                // Throw them to 4 corners!
                const spreadX = 300;
                const spreadY = 300;

                // Fixed positions for 4 images: TL, TR, BL, BR
                let positions = [
                    { x: -spreadX, y: -spreadY, r: -15 }, // Top-Left
                    { x: spreadX, y: -spreadY, r: 15 }, // Top-Right
                    { x: -spreadX, y: spreadY, r: 10 }, // Bottom-Left
                    { x: spreadX, y: spreadY, r: -10 }, // Bottom-Right
                ];

                // Shuffle positions randomly
                positions = positions.sort(() => Math.random() - 0.5);

                imgs.forEach((img, i) => {
                    const pos = positions[i] || positions[0]; // Fallback
                    // Add slight random variation so it's not robotic
                    const randomOffset = (Math.random() - 0.5) * 50;

                    const finalX = pos.x + randomOffset;
                    const finalY = pos.y + randomOffset;
                    const finalR = pos.r + (Math.random() - 0.5) * 10;

                    // Store state
                    img.dataset.x = finalX;
                    img.dataset.y = finalY;
                    img.dataset.r = finalR;

                    img.style.transform = `translate(${finalX}px, ${finalY}px) rotate(${finalR}deg) scale(1.5)`;
                    img.style.opacity = "1";
                    img.style.zIndex = "50";
                });
            } else {
                // Show main image
                mainImageBtn.style.opacity = "1";
                mainImageBtn.style.pointerEvents = "auto";

                // Return them
                imgs.forEach((img) => {
                    img.style.transform = "translate(0, 0) scale(0.5)";
                    img.style.opacity = "0";
                    img.style.zIndex = "0";
                });
            }
        });
    }
</script>

