---
import myProfile from "../assets/myProfileNoBg.png";
import Image from "astro/components/Image.astro";
import ProjectList from "./ProjectList.astro";
import TerminalLine from "./TerminalLine.astro";
import {
    Github,
    Linkedin,
    Twitter,
    Mail,
    ArrowRight,
    ArrowUp,
    MoveUpRight,
    Square,
    Youtube,
    Monitor,
    Terminal,
    Layers,
    Code2,
    GitBranch,
} from "lucide-react";
import myCV from "/cv.pdf";
import portfolio from "../data/portfolio.json";

const backendSkills = [
    { description: "Designing RESTful APIs with clear resource boundaries" },
    { description: "Authentication and authorization with user-scoped access" },
    {
        description:
            "Pagination, filtering, and validation for real-world datasets",
    },
    {
        description:
            "Writing backend logic with maintainability and clarity in mind",
    },
];

const databaseSkills = [
    { description: "Relational data modeling and schema design" },
    {
        description:
            "Understanding indexes and their impact on query performance",
    },
    {
        description:
            "Using ORMs pragmatically instead of treating them as black boxes",
    },
    {
        description:
            "Evaluating trade-offs between stored procedures and ORM logic",
    },
];

const systemSkills = [
    {
        description:
            "Working comfortably in a Linux-based development environment",
    },
    {
        description:
            "Basic understanding of processes, memory, and file systems",
    },
    {
        description:
            "Familiarity with core networking concepts relevant to web backends",
    },
    { description: "Interest in how systems work under the hood" },
];

const toolingSkills = [
    { description: "Git for version control and collaborative workflows" },
    { description: "Docker for consistent local development and deployment" },
    {
        description:
            "Neovim as a primary, keyboard-driven development environment",
    },
];

const workExperience = [
    {
        description: `Architected and Implemented scalable features for a high-traffic, Multi-Tenant Learning
Management System (LMS) using ASP .NET Core, ensuring strict data isolation and
performance across diverse client environments.`,
    },
    {
        description: `Implemented Custom script injection in ASP .NET framework “Contender” like the Wordpress
for drag and drop website creation.`,
    },
    {
        description: `Collaborated in an Agile environment to deliver full-stack functionality, integrating complex
back-end logic with modern front-end components.`,
    },
];

const myUsages = [
    {
        title: "OS",
        description: "MacOS",
        icon: Monitor,
    },
    {
        title: "Terminal",
        description: "Ghostty",
        icon: Terminal,
    },
    {
        title: "Multiplexer",
        description: "Tmux",
        icon: Layers,
    },
    {
        title: "Editor",
        description: "Neovim, VSCode",
        icon: Code2,
    },
    {
        title: "VC",
        description: "Git",
        icon: GitBranch,
    },
];

const links = [
    {
        title: "GitHub",
        url: "https://github.com/Nitesh-mint",
        icon: Github,
    },
    {
        title: "LinkedIn",
        url: "https://www.linkedin.com/in/nitesh-raya-614055249/",
        icon: Linkedin,
    },
    {
        title: "Youtube",
        url: "https://www.youtube.com/@niteshraya",
        icon: Youtube,
    },
];
const current = portfolio.current ?? null;
---

<section id="home" class="relative border-b-[3px] border-border-primary overflow-hidden">
    <!-- Decorative Background Pattern -->
    <div
        aria-hidden="true"
        class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_center,_var(--text-color)_1px,_transparent_1px)] bg-[length:20px_20px]"
    >
    </div>

    <div
        class="relative flex flex-col min-h-[85vh] md:min-h-[92vh] p-8 md:p-12"
    >
        <!-- Name -->
        <h1
            class="relative z-10 shrink-0 font-display font-black text-6xl sm:text-7xl md:text-[9rem] leading-[0.85] uppercase tracking-tighter flex flex-col md:flex-row md:justify-between md:items-start w-full"
        >
            <span class="text-transparent [-webkit-text-stroke:2px_var(--text-color)]"
                >Nitesh</span
            >
            <span class="text-text-primary">Raya</span>
        </h1>

        <!-- Image + bottom overlay fill the rest of the section, flush to the bottom border -->
        <div class="relative flex-1 min-h-0 -mx-8 md:-mx-12">
            <div
                class="relative h-[42vh] sm:h-[48vh] md:absolute md:inset-0 md:h-auto flex items-end justify-center"
            >
                <div
                    id="profile-spotlight"
                    class="relative h-full w-full max-w-xl md:max-w-3xl"
                >
                    <Image
                        src={myProfile}
                        alt=""
                        aria-hidden="true"
                        class="absolute inset-0 w-full h-full object-contain object-bottom contrast-125"
                        loading="eager"
                    />
                    <Image
                        id="profile-spotlight-mask"
                        src={myProfile}
                        alt="Profile"
                        class="absolute inset-0 w-full h-full object-contain object-bottom grayscale contrast-125"
                        loading="eager"
                    />
                </div>
            </div>

            <!-- Bottom overlay: title/bio/CTA left, social pills right -->
            <div
                class="relative md:absolute md:inset-x-0 md:bottom-0 z-20 flex flex-col md:flex-row md:items-end md:justify-between gap-6 px-8 md:px-12 pb-4"
            >
                <div class="flex flex-col gap-4 max-w-md bg-bg-primary/90 backdrop-blur-sm p-4 -m-4">
                    <div class="pl-6 border-l-[6px] border-text-primary">
                        <h2
                            class="font-mono font-bold text-xl md:text-2xl uppercase tracking-widest text-text-muted"
                        >
                            Full Stack Developer
                        </h2>
                    </div>

                    <p class="font-mono text-lg max-w-md">
                        Backend-first developer who enjoys building simple,
                        reliable systems with minimal interfaces.
                    </p>

                    <div>
                        <a
					    href={myCV}
					    download
                            class="btn-brutal text-center w-full md:w-auto"
                            >Download Resume <MoveUpRight
                                className="inline-block w-4 h-4 ml-2"
                            />
                        </a>
                    </div>
                </div>

                <div class="flex flex-row md:flex-col gap-3">
                    {
                        links.map(({ title, url, icon: Icon }) => (
                            <a
                                href={url}
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={title}
                                class="flex items-center gap-2 pl-3 pr-4 py-2 rounded-full border-[3px] border-text-primary bg-bg-primary font-mono text-xs font-bold uppercase shadow-[3px_3px_0_var(--text-color)] hover:bg-text-primary hover:text-bg-primary hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-none transition-all duration-100"
                            >
                                <Icon className="w-4 h-4" />
                                <span class="hidden sm:inline">{title}</span>
                            </a>
                        ))
                    }
                    <a
                        href="mailto:niteshraya@protonmail.com"
                        class="flex items-center gap-2 pl-3 pr-4 py-2 rounded-full border-[3px] border-text-primary bg-bg-primary font-mono text-xs font-bold uppercase shadow-[3px_3px_0_var(--text-color)] hover:bg-text-primary hover:text-bg-primary hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-none transition-all duration-100"
                        aria-label="Email"
                    >
                        <Mail className="w-4 h-4" />
                        <span class="hidden sm:inline">Email</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Current status -->
    {current && (
                <section
                    aria-labelledby="status-heading"
                    class="relative z-20 px-8 md:px-12 py-12 md:py-16 border-t-[3px] border-border-primary"
                >
                    <h3 id="status-heading" class="sr-only">Current status</h3>

                    <div class="max-w-3xl border-[3px] border-border-primary shadow-[8px_8px_0_var(--border-color)] bg-bg-primary overflow-hidden">
                        <!-- Title bar -->
                        <div
                            aria-hidden="true"
                            class="flex items-center gap-2 px-4 py-3 border-b-[3px] border-border-primary bg-bg-secondary"
                        >
                            <span class="w-3 h-3 rounded-full bg-red-500 border border-black/20"></span>
                            <span class="w-3 h-3 rounded-full bg-yellow-500 border border-black/20"></span>
                            <span class="w-3 h-3 rounded-full bg-green-500 border border-black/20"></span>
                            <span class="ml-2 font-mono text-[10px] md:text-xs uppercase tracking-widest text-text-muted">
                                nitesh@portfolio — status
                            </span>
                        </div>

                        <!-- Body -->
                        <div class="p-6 md:p-8 font-mono text-xs md:text-sm space-y-5">
                            <!-- Prompt 1: status -->
                            <div>
                                <TerminalLine command="curl --silent /api/status" />
                                <div class="mt-1.5 flex items-center gap-2 pl-3">
                                    <span aria-hidden="true" class="inline-block w-2 h-2 rounded-full bg-green-500 animate-ping"></span>
                                    <span class="font-black uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
                                        {current.status.replace(/_/g, " ")}
                                    </span>
                                </div>
                            </div>

                            <!-- Prompt 2: focus -->
                            <div>
                                <TerminalLine command="cat focus.txt" />
                                <div class="mt-1.5 pl-3 text-text-primary font-medium leading-relaxed">
                                    {current.focus}
                                </div>
                            </div>

                            <!-- Prompt 3: learning -->
                            {current.learning && current.learning.length > 0 && (
                                <div>
                                    <TerminalLine command="echo $LEARNING" />
                                    <ul class="mt-1.5 pl-3 flex flex-wrap gap-x-3 gap-y-1 text-text-muted font-bold list-none">
                                        {current.learning.map((item) => (
                                            <li class="text-text-primary">
                                                &bull; {item}
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            )}

                            <!-- Prompt 4: active projects -->
                            {current.working_on && current.working_on.length > 0 && (
                                <div>
                                    <TerminalLine command="git log --oneline -1 current_work/" />
                                    <ul class="mt-1.5 pl-3 space-y-3 list-none">
                                        {current.working_on.map((project) => (
                                            <li class="border-l-2 border-border-primary/20 pl-2 py-0.5">
                                                <div class="font-black text-text-primary flex items-center gap-2 flex-wrap">
                                                    <span>{project.title}</span>
                                                    {project.url && (
                                                        <a
                                                            href={project.url}
                                                            target="_blank"
                                                            rel="noopener noreferrer"
                                                            class="text-[10px] text-blue-600 dark:text-blue-400 underline hover:text-text-primary font-bold cursor-pointer"
                                                        >
                                                            [view repo]
                                                        </a>
                                                    )}
                                                </div>
                                                {project.description && (
                                                    <p class="text-text-muted mt-1 leading-snug text-xs max-w-sm">
                                                        {project.description}
                                                    </p>
                                                )}
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            )}

                            <!-- Live cursor -->
                            <div aria-hidden="true" class="flex items-baseline gap-1.5 text-text-muted pt-1">
                                <span class="flex items-baseline gap-1.5">
                                    <span class="text-terminal-user font-bold">nitesh</span>
                                    <span>@</span>
                                    <span class="text-terminal-host font-bold">portfolio</span>
                                    <span>:~$</span>
                                </span>
                                <span class="cursor-blink inline-block w-2 h-4 bg-text-primary"></span>
                            </div>
                        </div>
                    </div>
                </section>
            )}
</section>

<style>
    #profile-spotlight-mask {
        --mx: -9999px;
        --my: -9999px;
        mask-image: radial-gradient(
            circle 160px at var(--mx) var(--my),
            transparent 0%,
            transparent 55%,
            black 95%
        );
        -webkit-mask-image: radial-gradient(
            circle 160px at var(--mx) var(--my),
            transparent 0%,
            transparent 55%,
            black 95%
        );
    }
</style>

<script>
    const spotlight = document.getElementById("profile-spotlight");
    const mask = document.getElementById("profile-spotlight-mask");

    if (spotlight && mask) {
        spotlight.addEventListener("pointermove", (e) => {
            const rect = spotlight.getBoundingClientRect();
            mask.style.setProperty("--mx", `${e.clientX - rect.left}px`);
            mask.style.setProperty("--my", `${e.clientY - rect.top}px`);
        });

        spotlight.addEventListener("pointerleave", () => {
            mask.style.setProperty("--mx", "-9999px");
            mask.style.setProperty("--my", "-9999px");
        });
    }
</script>

<!-- About section -->
<section
    id="about"
    class="px-8 md:px-8 py-8 border-b-[3px] border-border-primary"
>
    <h3
        class="font-display font-black text-3xl md:text-6xl leading-[0.9] uppercase tracking-wider mb-6 text-right"
    >
        .About
    </h3>
    <div class="space-y-6 max-w-3xl">
        <p class="text-sm md:text-xl leading-relaxed">
            I've always been more curious about the <span class="bg-text-primary text-bg-primary px-1 font-bold">"how"</span> than the "what". My journey into development started with a fascination for the invisible logic that powers the web—the complex puzzles where data flow meets architectural constraints.
        </p>
        <p class="text-sm md:text-xl leading-relaxed">
            I care deeply about <span class="italic">predictability and resilience</span>. To me, a good backend isn't just about moving data; it's about building systems that are maintainable, performant, and honest in their implementation. 
        </p>
        <p class="text-sm md:text-xl leading-relaxed font-bold">
            Currently, I'm focused on deep-diving into system fundamentals and exploring how to design multi-tenant architectures that scale without the complexity tax. 
        </p>
        <p class="text-sm md:text-xl italic">
            And yes, I actually enjoy writing CSS too! :-)
        </p>
    </div>
</section>

<section
    id="skills"
    class="px-8 md:px-8 py-8 border-b-[3px] border-border-primary"
>
    <h3
        class="font-display font-black text-3xl md:text-6xl leading-[0.9] uppercase tracking-wider mb-12"
    >
        Technical Skills.
    </h3>

    <div class="space-y-4 mb-12">
        {
            Object.entries(portfolio.skills).map(([category, items]) => (
                <div class="flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-6">
                    <span class="font-mono text-xs uppercase tracking-widest text-text-muted sm:w-32 shrink-0">
                        {category}
                    </span>
                    <div class="flex flex-wrap gap-2">
                        {items.map((item) => (
                            <span class="font-mono text-xs md:text-sm font-bold uppercase border-[2px] border-border-primary px-3 py-1.5 hover:bg-text-primary hover:text-bg-primary transition-colors duration-150">
                                {item}
                            </span>
                        ))}
                    </div>
                </div>
            ))
        }
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="card-brutal h-full">
            <h4
                class="font-display text-xl mb-4 border-b-[3px] border-border-primary pb-2 inline-block"
            >
                Backend & APIs
            </h4>
            <div class="space-y-3">
                {
                    backendSkills.map((skill) => (
                        <div class="flex gap-3 items-start">
                            <Square className="w-4 h-4 mt-1.5 flex-shrink-0 fill-current" />
                            <span class="font-mono text-sm md:text-base text-text-muted">
                                {skill.description}
                            </span>
                        </div>
                    ))
                }
            </div>
        </div>

        <div class="card-brutal h-full">
            <h4
                class="font-display text-xl mb-4 border-b-[3px] border-border-primary pb-2 inline-block"
            >
                Database
            </h4>
            <div class="space-y-3">
                {
                    databaseSkills.map((skill) => (
                        <div class="flex gap-3 items-start">
                            <Square className="w-4 h-4 mt-1.5 flex-shrink-0 fill-current" />
                            <span class="font-mono text-sm md:text-base text-text-muted">
                                {skill.description}
                            </span>
                        </div>
                    ))
                }
            </div>
        </div>

        <div class="card-brutal h-full">
            <h4
                class="font-display text-xl mb-4 border-b-[3px] border-border-primary pb-2 inline-block"
            >
                System & Fundamentals
            </h4>
            <div class="space-y-3">
                {
                    systemSkills.map((skill) => (
                        <div class="flex gap-3 items-start">
                            <Square className="w-4 h-4 mt-1.5 flex-shrink-0 fill-current" />
                            <span class="font-mono text-sm md:text-base text-text-muted">
                                {skill.description}
                            </span>
                        </div>
                    ))
                }
            </div>
        </div>

        <div class="card-brutal h-full">
            <h4
                class="font-display text-xl mb-4 border-b-[3px] border-border-primary pb-2 inline-block"
            >
                Tooling & Workflow
            </h4>
            <div class="space-y-3">
                {
                    toolingSkills.map((skill) => (
                        <div class="flex gap-3 items-start">
                            <Square className="w-4 h-4 mt-1.5 flex-shrink-0 fill-current" />
                            <span class="font-mono text-sm md:text-base text-text-muted">
                                {skill.description}
                            </span>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>
<!-- Experience section-->
<section
    id="work"
    class="px-8 md:px-8 py-8 border-b-[3px] border-border-primary"
>
    <h3
        class="font-display font-black text-3xl md:text-6xl leading-[0.9] uppercase tracking-wider mb-6"
    >
        .Work
    </h3>
    <div class="card-brutal">
        <div
            class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6"
        >
            <h4 class="font-display text-2xl md:text-4xl font-black uppercase">
                Braindigit
            </h4>
            <span
                class="font-mono text-sm md:text-base bg-text-primary text-bg-primary px-2 py-1"
            >
                <time datetime="2025-01">2025</time> - Present
            </span>
        </div>

        <h5
            class="font-mono text-xl md:text-2xl font-bold mb-6 text-text-muted border-b-[3px] border-border-primary pb-2 inline-block"
        >
            Full Stack Developer
        </h5>

        <div class="space-y-4">
            {
                workExperience.map((work) => (
                    <div class="flex gap-4 items-start">
                        <Square className="w-5 h-5 mt-1.5 flex-shrink-0 fill-current" />
                        <p class="font-mono text-base md:text-lg leading-relaxed">
                            {work.description}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<ProjectList />

<section
    id="uses"
    class="px-8 md:px-8 py-8 border-b-[3px] border-border-primary"
>
    <h3
        class="font-display font-black text-3xl md:text-6xl leading-[0.9] uppercase tracking-wider mb-8"
    >
        I Use..
    </h3>
    <div class="flex flex-col border-[3px] border-border-primary divide-y-[3px] divide-border-primary sm:grid sm:grid-cols-2 sm:gap-4 sm:border-0 sm:divide-y-0 md:grid-cols-5">
        {
            myUsages.map((usage) => (
                <div class="flex flex-row items-center gap-4 p-4 hover:bg-bg-secondary transition-colors duration-200 sm:flex-col sm:items-center sm:justify-center sm:text-center sm:p-6 sm:border-[3px] sm:border-border-primary sm:bg-bg-primary sm:shadow-[8px_8px_0_var(--border-color)] sm:hover:-translate-x-[2px] sm:hover:-translate-y-[2px] sm:hover:shadow-[10px_10px_0_var(--border-color)]">
                    <usage.icon className="w-8 h-8 shrink-0 sm:w-10 sm:h-10 sm:mb-4" />
                    <div class="flex flex-col gap-1 sm:items-center">
                        <span class="font-display text-[10px] uppercase tracking-widest text-text-muted">
                            {usage.title}
                        </span>
                        <span class="font-mono font-black text-base md:text-lg uppercase">
                            {usage.description}
                        </span>
                    </div>
                </div>
            ))
        }
    </div>
</section>
